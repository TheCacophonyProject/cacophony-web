{
  "name": "cacophony-api",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCacophonyProject/cacophony-api.git"
  },
  "version": "0.0.1",
  "type": "module",
  "exports": "./Server.js",
  "aliases": {
    "@": "./",
    "@typedefs": "../types",
    "@schemas": "../api/json-schemas",
    "@api": "./api",
    "@models": "./models",
    "@config": "./config.js",
    "@log": "./logging.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.338.0",
    "@aws-sdk/lib-storage": "^3.338.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mapbox/node-pre-gyp": "^1.0.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "apidoc": "^0.50.0",
    "apidoc-plugin-ts": "github:TheCacophonyProject/apidoc-plugin-ts#v1.1.0",
    "commander": "^14.0.2",
    "earcut": "^2.2.4",
    "emailjs": "^4.0.3",
    "esm-module-alias": "^2.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "express-winston": "^4.2.0",
    "fast-csv": "^4.3.6",
    "fluent-ffmpeg": "^2.1.2",
    "handlebars": "^4.7.7",
    "influx": "^5.9.2",
    "jsdom": "^19.0.0",
    "jsonwebtoken": "^9.0.0",
    "levenshtein-edit-distance": "2.0.5",
    "lodash": "^4.17.13",
    "mime": "^2.4.4",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.28",
    "multiparty": "^4.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "scale-color-perceptual": "^1.1.2",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "sql-formatter": "^15.3.0",
    "temp": "^0.9.4",
    "tz-lookup-oss": "^6.3.0",
    "uuid": "^8.3.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^8.3.8",
    "@types/lodash": "^4.14.202",
    "@types/multiparty": "^4.2.1",
    "@types/mime": "^2.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "typescript-eslint": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "@eslint/compat": "^1.4.1",
    "jiti": "^2.6.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-utils": "^3.0.0",
    "prettier": "^3.6.2",
    "smtp-tester": "^2.0.1",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "bcrypt": "^5.0.1",
    "sharp": "^0.32.1"
  },
  "scripts": {
    "lint": "eslint -c ./eslint.config.ts || (echo \"Please run 'npm run lint:fix' to clean up formatting of files.\"; false)",
    "lint:fix": "eslint -c ./eslint.config.ts --fix",
    "apidoc": "apidoc -c ./apidoc.json -f \".*\\.ts$\" -i api/V1 -o apidoc/",
    "db-migrate": "sequelize db:migrate",
    "new-migration": "sequelize migration:generate --name",
    "dev": "docker compose build && docker compose up --force-recreate",
    "dev:bash": "docker compose exec server bash",
    "clean": "tsc --build --clean"
  }
}
