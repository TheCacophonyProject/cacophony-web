  "name": "cacophony-api",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCacophonyProject/cacophony-api.git"
  },
  "version": "1.50.0",
  "type": "module",
  "exports": "./Server.js",
  "aliases": {
    "@": "./",
    "@typedefs": "../types",
    "@schemas": "../api/json-schemas",
    "@api": "./api",
    "@models": "./models",
    "@config": "./config.js",
    "@log": "./logging.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.338.0",
    "@aws-sdk/lib-storage": "^3.338.0",
    "@aws-sdk/node-http-handler": "^3.370.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "apidoc": "^0.50.0",
    "apidoc-plugin-ts": "github:TheCacophonyProject/apidoc-plugin-ts#v1.1.0",
    "commander": "^14.0.2",
    "earcut": "^3.0.2",
    "emailjs": "^4.0.3",
    "esm-module-alias": "^2.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "express-winston": "^4.2.0",
    "fast-csv": "^4.3.6",
    "fluent-ffmpeg": "^2.1.2",
    "handlebars": "4.7.9",
    "influx": "^5.9.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "levenshtein-edit-distance": "2.0.5",
    "lodash": "^4.18.1",
    "mime": "^2.4.4",
