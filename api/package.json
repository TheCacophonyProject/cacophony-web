    "pg": "^8.16.3",
    "scale-color-perceptual": "^1.1.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.3",
    "simple-swizzle": "^0.2.4",
    "sql-formatter": "^15.3.0",
    "temp": "^0.9.4",
    "tz-lookup-oss": "^6.3.0",
    "uuid": "13.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/busboy": "^1.5.4",
    "@types/earcut": "^3.0.0",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/levenshtein-edit-distance": "^2.0.1",
    "@types/lodash": "^4.14.202",
    "@types/mime": "^2.0.3",
    "@types/node": "^24.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/temp": "^0.9.4",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jiti": "^2.6.1",
    "smtp-tester": "^2.0.1",
    "tsc-watch": "^7.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.46.3"
  },
  "optionalDependencies": {
    "bcrypt": "^5.0.1",
    "sharp": "^0.32.1"
  },
  "scripts": {
    "lint": "eslint -c ./eslint.config.ts || (echo \"Please run 'npm run lint:fix' to clean up formatting of files.\"; false)",
    "lint:fix": "eslint -c ./eslint.config.ts --fix",
    "apidoc": "apidoc -c ./apidoc.json -f \".*\\.ts$\" -i api/V1 -o apidoc/",
    "db-migrate": "sequelize db:migrate",
    "new-migration": "sequelize migration:generate --name",
    "dev": "docker compose build && docker compose up --force-recreate --no-log-prefix",
    "dev:bash": "docker compose exec server bash",
    "clean": "tsc --build --clean"
  }
}
