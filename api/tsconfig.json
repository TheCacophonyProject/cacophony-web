{
    "compilerOptions": {
        "strictNullChecks": false,
        "target": "es2021",
        "sourceMap": true,
        "module": "nodenext",
        "outDir": "../",
        "rootDir": "../",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "paths": {
            "*": ["./*"],
            "@/*": ["./*"],
            "@typedefs/*":  ["../types/*"],
            "@schemas/*":  ["./json-schemas/*"],
            "@api/*":  ["./api/*"],
            "@models/*":  ["./models/*"],
            "@models":  ["./models/index.ts"],
            "@config":  ["./config.ts"],
            "@log":  ["./logging.ts"]
        }
    },
    "tsc-alias": {
        "verbose": true,
        "resolveFullPaths": true,
        "watch": true
    },
    "include": [
        "./models/**/*.ts",
        "./api/**/*.ts",
        "./scripts/**/*.ts",
        "./**/*.ts",
        "./*.ts",
        "../types/**/*.ts",
        "../types/**/*.js",
        "../types/**/*.json"
    ],
    "exclude": [
        "./node_modules/*",
        "../types/build-schemas.ts"
    ],
    "watchOptions": {
        "excludeDirectories": [
            "./node_modules",
            "./node_modules/**",
        ],
        "excludeFiles": [
            "*.schema.json",
            "../types/jsonSchemas/**/*.json",
            "../types/build-schemas.js",
            "../types/build-schemas.ts",
            "../types/schema-cache.json",
            "schema-cache.json"
        ],
    }
}
