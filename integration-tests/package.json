{
  "name": "integration-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node ./node_modules/.bin/cypress open",
    "browse": "node ./node_modules/.bin/cypress open --config-file cypress-browse.config.ts",
    "release": "node ./node_modules/.bin/cypress run --config-file cypress-api-release.config.ts",
    "ci-batch-1": "node ./node_modules/.bin/cypress run --config-file cypress-api-batch-1.config.ts",
    "ci-batch-2": "node ./node_modules/.bin/cypress run --config-file cypress-api-batch-2.config.ts",
    "lint": "eslint -c ./eslint.config.ts || (echo \"Please run 'npm run lint:fix' to clean up formatting of files.\"; false)",
    "lint:fix": "eslint -c ./eslint.config.ts --fix"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@types/node": "^24.10.9",
    "@vue/cli-service": "^5.0.8",
    "cypress": "^15.9.0",
    "cypress-fail-fast": "^8.1.0",
    "cypress-promise": "^1.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vue": "^3.3.2",
    "webpack": "^5.73.0"
  },
  "author": "",
