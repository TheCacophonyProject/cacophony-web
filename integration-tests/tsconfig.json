{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["ESNext", "dom", "dom.iterable"],
        "types": ["cypress"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@shared/*":  ["../types/*"],
            "@typedefs/*":  ["../types/*"],
            "@commands/*": ["./cypress/commands/*"],
            "@/*": ["./cypress/*"],
        }
    },
    "exclude": [
        "node_modules"
    ],
    "references": [
        { "path": "./support/" }
    ],
    "include": [
        "**/*.ts",
        "**/*.d.ts",
        "../types/**/*.ts",
        "cypress/support/index.d.ts"
    ]
}
