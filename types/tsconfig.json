{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2020",
        "sourceMap": false,
        "esModuleInterop": true,
        "moduleResolution": "nodenext",
        "baseUrl": ".",
        "lib": ["ESNext", "dom", "dom.iterable"],
        "paths": {
            "@typedefs/*":  ["./*"],
        }
    },
    "exclude": [
        "node_modules",
        "types/client/**"
    ],
    "include": [
        "./**/*.ts",
    ]
}
