{
  "name": "browse-next",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --force --host",
    "build": "vite build",
    "build-for-tests": "concurrently -k \"vite build --watch --mode e2e\" \"vite preview --port 5050\"",
    "preview": "vite build --mode development && vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint . && oxfmt -c ../.oxfmtrc.json --check .",
    "lint:fix": "oxlint --fix . && oxfmt -c ../.oxfmtrc.json ."
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/vue": "^1.1.4",
    "@jsquash/webp": "^1.1.3",
    "@popperjs/core": "^2.11.7",
    "@vueform/multiselect": "^2.6.10",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^9.13.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.40.7",
    "chartist": "^1.3.0",
    "hash-wasm": "^4.9.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.3.0",
    "material-symbols": "^0.46.0",
    "scale-color-perceptual": "^1.1.2",
    "spectastiq": "github:hardiesoft/spectastiq#v0.10.3",
    "suncalc": "^1.9.0",
    "tz-lookup-oss": "^6.3.0",
    "vue": "^3.5.25",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "globals": "^16.5.0",
    "less": "^4.6.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.0.7",
    "vue-tsc": "^3.1.5"
  }
}
