[Unit]
Description=Cacophony Project API server
After=network.target

[Service]
WorkingDirectory=/srv/cacophony/api
ExecStart=/usr/bin/node --max-old-space-size=2048 --disable-warning=ExperimentalWarning --no-warnings --loader esm-module-alias/loader Server.js --config=/etc/cacophony/api.js
Restart=on-failure
RestartSec=20s
User=fullnoise
Group=fullnoise
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
